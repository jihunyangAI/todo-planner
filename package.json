{
  "name": "todo-planner",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14"
    }
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:stop": "docker compose stop mongo",
    "predev": "npm run build -w shared",
    "dev": "concurrently -k -n shared,server,web \"npm run dev -w shared\" \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces",
    "build:vercel": "npm run build --workspaces",
    "pretest": "npm run build -w shared",
    "test": "vitest run",
    "pretest:tz": "npm run build -w shared",
    "test:tz": "cross-env TZ=America/Los_Angeles vitest run",
    "pretest:e2e": "npm run build -w shared",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "pretypecheck": "npm run build -w shared",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.4"
  }
}
