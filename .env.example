# api
MONGODB_URI=mongodb://localhost:27017/todo-planner
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Render·Railway처럼 프록시 뒤에서 실행할 때 1
TRUST_PROXY=0
# 테스트·E2E에서만 true
RATE_LIMIT_DISABLED=false

# web (빌드 시점에 주입)
VITE_API_URL=http://localhost:4000

# 테스트용 mongodb-memory-server 버전 (package.json config와 같은 값)
MONGOMS_VERSION=7.0.14
