# .env로 복사해서 값을 채운다. .env는 git에 올라가지 않는다(.gitignore).

# ── api ──
MONGODB_URI=mongodb://localhost:27017/todo-planner
PORT=4000
# Render·Railway처럼 프록시 뒤에서 실행할 때 1
TRUST_PROXY=0
# 테스트·E2E에서만 true
RATE_LIMIT_DISABLED=false

# ── GitHub OAuth 로그인 ──
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App 에서 만든 값 (README의 "GitHub 로그인 설정")
# Authorization callback URL: http://localhost:5173/auth/github/callback (로컬)
GITHUB_CLIENT_ID=
# 비밀값: 코드나 git에 넣지 말고 .env(로컬)·호스팅 환경 변수(운영)에만 둔다
GITHUB_CLIENT_SECRET=
# 세션 쿠키 서명용 무작위 문자열(32자 이상). 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 사용자가 접속하는 주소. OAuth 콜백 주소({PUBLIC_URL}/auth/github/callback)를 만든다
# 로컬은 Vite 개발 서버 주소. Render에서는 비워 두면 RENDER_EXTERNAL_URL을 쓴다
PUBLIC_URL=http://localhost:5173
# true면 API가 web/dist를 함께 서빙한다(운영). 로컬 개발은 Vite 프록시를 쓰므로 false
SERVE_WEB=false

# ── web (Vite) ──
# 개발 서버가 /api·/auth를 전달할 API 주소
API_PROXY_TARGET=http://localhost:4000

# ── 테스트 ──
# mongodb-memory-server 버전 (package.json config와 같은 값)
MONGOMS_VERSION=7.0.14
