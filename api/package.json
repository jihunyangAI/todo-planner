{
  "name": "@todo/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "node dist/server.js",
    "e2e": "tsx src/e2e-server.ts",
    "migrate": "tsx --env-file-if-exists=../.env src/migrate-cli.ts"
  },
  "dependencies": {
    "@todo/shared": "*",
    "connect-mongo": "^5.1.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "mongodb": "^6.12.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2"
  }
}
